# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- Azure OpenAI ---
# Resource endpoint, e.g. https://your-resource-name.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Bump this if your gpt-5-mini deployment needs a newer API version to accept vision input,
# e.g. 2024-12-01-preview. See README > Troubleshooting.
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-5-mini

# --- OpenAI fallback ---
# Used only if the Azure deployment above rejects a vision/chat call (e.g. no vision support).
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Vector store backend: "faiss" (local, default) or "pinecone" (cloud) ---
VECTOR_STORE_BACKEND=faiss
EMBEDDING_DIMENSION=1536

# FAISS (only used when VECTOR_STORE_BACKEND=faiss)
FAISS_INDEX_DIR=embeddings
FAISS_INDEX_NAME=faiss_index

# Pinecone (only used when VECTOR_STORE_BACKEND=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ai-rag-production
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Ingestion / chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_PAGE_TEXT_CHARS_FOR_PAGE_RENDER=40
TOP_K=4
# OCR (pytesseract) on low-text/scanned pages. Requires the `tesseract` binary on PATH
# (brew install tesseract / apt-get install tesseract-ocr) — degrades gracefully without it.
OCR_ENABLED=true

# --- Answer generation ---
LLM_TEMPERATURE=0.7
LLM_TOP_P=1.0

# --- Reranking (cross-encoder second-stage over the initial vector search) ---
# Default reranker runs locally via sentence-transformers (BAAI/bge-reranker-base) —
# no API key needed, but the first run downloads model weights from Hugging Face.
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CANDIDATE_POOL=20

# Reference only — see app/services/reranker.py for commented Cohere/Jina backends.
COHERE_API_KEY=
JINA_API_KEY=

# --- Streamlit UI (streamlit_app.py) ---
# Not read by the FastAPI backend — only by the Streamlit client, as a plain OS env var.
API_BASE_URL=http://localhost:8000
